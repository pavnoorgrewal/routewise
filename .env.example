# Copy to .env.local for local development. Create a Gemini API key in Google
# AI Studio and add the same server-only key to your hosting environment.
# Gemini 3.1 Flash-Lite has a free tier with rate limits. Keep the key private.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional paid alternatives, used only when the Gemini key is absent.
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Optional: enables an interactive route map inside trip summary cards.
# Restrict this browser key to your site's HTTP referrers and Maps Embed API.
# Without it, every trip still has a link that opens its route in Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
