# Copy to .env.local for local development. Add this server-only key to your
# hosting environment too. API usage is billed separately from ChatGPT.
OPENAI_API_KEY=

# Alternative: keep using Vercel AI Gateway instead of a direct OpenAI key.
AI_GATEWAY_API_KEY=

# Optional: enables an interactive route map inside trip summary cards.
# Restrict this browser key to your site's HTTP referrers and Maps Embed API.
# Without it, every trip still has a link that opens its route in Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
